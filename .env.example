# === API (apps/api/.env) ===
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ux_portfolio?retryWrites=true&w=majority
WEB_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=designer@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=designer@gmail.com
SMTP_PASS=
MAIL_FROM="Portfolio Admin <designer@gmail.com>"

# === Web (apps/web/.env.local) ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Studio Portfolio
